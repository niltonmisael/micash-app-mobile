{
  "expo": {
    "name": "MiCash",
    "slug": "micash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.micash.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F58A3C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.micash.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que o MiCash use o Face ID para desbloquear o app."
        }
      ],
      "expo-notifications"
    ],
    "scheme": "micash",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4a5f203b-d100-441b-be0b-e7c53ce2ecaa"
      }
    },
    "owner": "nilton_misael",
    "experiments": {
      "typedRoutes": true
    }
  }
}
