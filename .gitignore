*firebase-adminsdk*.json
*service-account*.json
*service_account*.json
*serviceAccount*.json

# Credenciais locais do EAS (credentials.json e os arquivos que ele referencia)
credentials.json
/credentials/

# Local environment (never commit secrets)
.env
.env.*
!.env.example

# Metro
.metro-health-check*

# Logs
